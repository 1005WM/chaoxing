<!-- Keystore keys cannot accompany state files onto another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="caochaoxing/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="caochaoxing/" />
    </device-transfer>
</data-extraction-rules>
